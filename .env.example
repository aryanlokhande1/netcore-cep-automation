# Runtime inference; never put real credentials in this example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Installed executable must be configured privately.
CHROMIUM_EXECUTABLE_PATH=
HEADLESS=false
# Optional private values, read only by the authorized login credential handler.
NETCORE_ACCOUNT_NAME=
NETCORE_USERNAME=
NETCORE_PASSWORD=
NETCORE_LOGIN_URL=https://login.netcoresmartech.com/
NETCORE_EXPECTED_HOST=tprappin2r.netcoresmartech.com
NETCORE_EVIDENCE_FILE=
# Live execution requires configuration and explicit command authorization.
NETCORE_LIVE_LOGIN_ENABLED=false
NETCORE_MAX_LOGIN_SUBMISSIONS=1
TEACHER_LIVE_REPLAY_ENABLED=false
NETCORE_LIVE_COMPARISON_ENABLED=false
# Separate Doer and Teacher bounds; CLI budgets can be lower.
DOER_MAX_OUTPUT_TOKENS=500
TEACHER_MAX_OUTPUT_TOKENS=2000
TEACHER_REASONING_EFFORT=low
TEACHER_MAX_INPUT_TOKENS=8000
TEACHER_REQUEST_BUDGET=3
LEARNING_MAX_REQUESTS=24
LEARNING_MAX_INPUT_TOKENS=240000
LEARNING_MAX_OUTPUT_TOKENS=21000

# Persistent skill history; relative paths resolve from the project root.
NETCORE_SKILL_HISTORY_DIR=outputs/skill_history/login
